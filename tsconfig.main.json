{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": ["src/main/**/*", "src/agent-pi/**/*", "src/mcp/**/*", "src/shared/**/*"]
}
